# rpi-lark-bridge — user configuration
#
# Copy to config/bridge.toml and edit. config/bridge.toml is gitignored because it
# contains your hardware's MAC addresses.
#
# Everything here is keyed on STABLE IDENTIFIERS — MAC addresses and udev properties —
# never on hci0, hw:1 or card 2, which renumber across reboots and replugs.

[bridge]
# bluetooth       Mode 1  — call over HFP, audio out over A2DP.        Gated on spike S3.
# bluetooth-wired Mode 1W — call over HFP, audio out over a USB DAC.   RECOMMENDED DEFAULT.
# usb             Mode 2  — Lark -> Pi -> Pico -> Pixel as a USB headset.
# diagnostics     Mode 3  — no policy, raw devices exposed.
mode = "bluetooth-wired"

# Friendly name the Pixel shows in its Bluetooth list.
name = "LarkBridge BT500"

# Start in this mode at boot. Set false to come up in diagnostics and switch by hand.
autostart = true


[devices.phone]
# The Pixel 7a. Find it with: bluetoothctl devices
address = "AA:BB:CC:DD:EE:FF"
# Permanent identity of the USB-BT500 that owns the Pixel bond.  The hciX name is
# deliberately not configuration: it changes with probe order and replugs.
adapter = "A0:AD:9F:73:6C:24"
adapter_product = "ASUS USB-BT500"
adapter_bus = "USB"
adapter_usb_vendor_id = "0b05"
adapter_usb_product_id = "1bf6"
# The Pi does NOT chase the phone with connect attempts — Android reconnects to trusted
# headsets aggressively and racing it causes collisions. We stay connectable and wait.
# One gentle attempt is allowed if the phone is known-present and silent for this long.
connect_after_idle_seconds = 60


[devices.output]
# The qualified BT500+AUX build has no Bluetooth output controller.  This stable
# PipeWire node is the Pi 3 headphone jack used by the Harmony boombox.
id = "wired:alsa_output.platform-3f00b840.mailbox.stereo-fallback"


[[devices.microphones]]
# Ordered microphone candidates: first uniquely usable entry wins. Never use ALSA card numbers.
id = "lark-a1"
label = "Hollyland Lark A1"
node_name = "alsa_input.usb-Shenzhen_Hollyland_Technology_Co._Ltd_Wireless_Microphone_Wireless_Microphone-01.analog-stereo"
usb_vendor_id = "3547"
usb_product_id = "0407"
usb_product = "Wireless Microphone"
usb_serial = ""
usb_port_path = ""
required_rate = 48000
required_format = "S16LE"
required_channels = 2
capture_only = true

[[devices.microphones]]
# The K054 exposes generic descriptors and no serial. Leaving usb_port_path blank permits moving it
# between ports but cannot distinguish an unrelated device with the same complete fingerprint.
id = "fifine-k054"
label = "FIFINE K054"
node_name = "alsa_input.usb-0c76_USB_PnP_Audio_Device-00.mono-fallback"
usb_vendor_id = "0c76"
usb_product_id = "161e"
usb_product = "USB PnP Audio Device"
usb_serial = ""
usb_port_path = ""
required_rate = 48000
required_format = "S16LE"
required_channels = 1
capture_only = true


[devices.wired_output]
# The USB audio dongle used in mode = "bluetooth-wired". Leave the IDs empty to fall back
# to the Pi's 3.5 mm jack — but note that requires dtparam=audio=on, which the installer
# turns off by default. A dongle is strongly preferred; the Pi 3B's PWM audio is poor.
usb_vendor_id  = ""     # e.g. "0d8c"  (C-Media CM108, the usual suspect)
usb_product_id = ""     # e.g. "013c"
use_headphone_jack = true


[audio]
# Graph rate. Fixed at 48 kHz by ADR-0007 — changing it is a design decision, not a tweak.
rate = 48000
# Quantum in frames. 1024 @ 48 kHz = 21.3 ms. Milestone M8 tunes this DOWN with XRUN
# counts as the gate. Do not lower it speculatively.
quantum = 1024
# Microphone gain in dB applied at the bridge.mic loopback, NOT at the device mixer —
# device mixers disappear on replug, node volumes do not.
mic_gain_db = 0.0
mic_muted = false
# Call audio volume in dB at the bridge.callout loopback.
output_gain_db = 0.0
# E09 measured 0.85 as approximately 0 dB at the Pi jack.  1.00 maps to about
# +4 dB and clips/compresses the PWM output, so the supervisor enforces this value.
wired_output_volume = 0.85


[audio.sidetone]
# Hear your own voice in the output. Off by default; some people find it essential and
# others find it maddening.
enabled = false
level_db = -20.0


[audio.aec]
# Acoustic echo cancellation. Not needed with headphones — there is no acoustic loop.
# Keep disabled until the wired baseline has been captured. When enabled, the supervisor
# owns a native PipeWire/WebRTC module whose lifetime is limited to an active call.
enabled = true
method = "webrtc"
# Fixed to the established graph rate and mono to preserve Pi 3 CPU headroom.
rate = 48000
channels = 1
# Never substitute the raw Lark automatically if AEC construction or verification fails.
failure_policy = "fail_closed"
# Installed WebRTC1 baseline. Keep these explicit so package defaults cannot drift.
high_pass_filter = true
noise_suppression = false
gain_control = false
voice_detection = false
transient_suppression = true
# Graph timing for the AEC module, in frames at the 48 kHz graph rate.
#
# This is the setting that decides whether the onboard jack crackles. The WebRTC module
# processes 10 ms blocks, so if node.latency is left unset it asks the graph for 480
# frames and PipeWire drops the ONBOARD SINK to min-quantum 256 to match. A 256-frame
# buffer on the bcm2835 PWM output does not survive call load: measured on the unit,
# echo-cancel-playback logged 417 underruns in 20 s at the default versus 5 at 1920,
# and each underrun is a click in the far-end audio.
#
# 1920 frames (40 ms) is E10's ten-trial-clean timing and keeps the sink at 1024.
# Set to a smaller value only with fresh underrun measurements to justify it.
node_latency_frames = 1920
# Extra delay on the AEC reference path. E10 found no added delay helped convergence on
# this fixture, so it stays unset. TOML has no null literal: leave the key commented out
# to omit buffer.play_delay from the module arguments entirely.
# play_delay_frames = 21600


[bluetooth]
# Prefer wideband speech (mSBC, 16 kHz) over CVSD (8 kHz). If the phone or controller
# refuses, the link silently falls back — which is why bridgectl always reports the
# codec actually in use. A silent CVSD fallback is the usual cause of "why does this
# sound like 1995".
prefer_msbc = true
# Disable onboard 2.4 GHz Wi-Fi to reduce coexistence pressure on the shared radio die.
# This is a MEASURED variable in stage E, not folklore — test both ways.
disable_wifi = true


[usb]
# Mode 2 only.
# 2 = UAC2 (default), 1 = UAC1 fallback. Which one Android accepts is decided empirically
# at milestone M9.3 on the actual Pixel — see ADR-0005.
uac_version = 2
# Where call audio goes once it arrives back from the Pico.
# "wired" | "bluetooth" | "jack" | "none"
return_path = "wired"


[diagnostics]
# journald is always used. This raises verbosity.
log_level = "info"          # debug | info | warn | error
# Diagnostic PCM taps are explicit and time-boxed by default. Recording call audio has
# consent and legal implications that vary by jurisdiction — see PLAN.md §15 Q5.
allow_persistent_recording = false
max_tap_seconds = 120
# Health check cadence and how aggressively the recovery ladder may climb.
health_interval_seconds = 5
recovery_rung_cooldown_seconds = 300
