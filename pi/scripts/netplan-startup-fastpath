#!/bin/sh
# Preserve Netplan generation while avoiding redundant manager reloads during boot.
set -eu

if [ "$#" -eq 1 ] && [ "$1" = generate ]; then
    state="$(systemctl is-system-running 2>/dev/null || true)"
    if [ "$state" = starting ]; then
        exec /usr/libexec/netplan/generate
    fi
fi

exec /usr/sbin/netplan "$@"
