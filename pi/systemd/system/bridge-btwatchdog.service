[Unit]
# Transitional compatibility unit for the old onboard-call deployment.
#
# New deployments enable bridge-btwatchdog@call.service and @output.service instead. This
# compatibility name remains available only so the preserved onboard rollback can start the
# same strict call-role implementation without resurrecting the old global recovery ladder.

Description=rpi-lark-bridge transitional call-controller watchdog
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/admin/rpi-lark-bridge/pi/bridged/bt_watchdog.py --role call
Restart=always
RestartSec=10

# Deliberately not given ProtectKernelTunables: exact-index rfkill and exact-interface USB
# unbind/rebind require narrow /sys writes. The watchdog rejects ambiguous controller identity.

# A targeted recovery rung is bounded and does not restart BlueZ or the audio session.
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
