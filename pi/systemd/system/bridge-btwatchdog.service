[Unit]
# Compatibility name for the strict call-controller instance. New installs enable
# bridge-btwatchdog@call.service; this unit never invokes the retired BCM/global reset ladder.
Description=rpi-lark-bridge strict BT500 call-controller watchdog
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/admin/rpi-lark-bridge/pi/bridged/bt_watchdog.py --role call
Restart=always
RestartSec=10
RestartPreventExitStatus=2 3 4
UMask=0077

# Deliberately not given ProtectKernelTunables: exact-index rfkill and exact-interface USB
# unbind/rebind require narrow /sys writes. The watchdog rejects ambiguous controller identity.

# A targeted recovery rung is bounded and does not restart BlueZ or the audio session.
TimeoutStopSec=45
KillMode=mixed

[Install]
WantedBy=multi-user.target
