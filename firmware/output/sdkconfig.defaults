# LarkBridge output controller: ESP32-DevKitC-32UE, ESP-IDF v6.0.2.
CONFIG_IDF_TARGET="esp32"

# This board uses Bluetooth Classic only. Keep the legacy PCM callback path so
# Bluedroid performs SBC encoding for the A2DP source.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=n
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_A2DP_USE_EXTERNAL_CODEC=n

# Keep diagnostics available during first hardware bring-up.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# The ordered ESP32-WROOM-32UE has 4 MiB flash. A 2 MiB factory partition
# leaves room for Bluetooth growth while a separate crash-dump partition keeps
# first-hardware failures recoverable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# UART/I2S worker timing is expressed in milliseconds.
CONFIG_FREERTOS_HZ=1000
