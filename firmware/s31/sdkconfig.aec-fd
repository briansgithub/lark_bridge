# D5 test overlay. Apply after sdkconfig.test.
CONFIG_LARKBRIDGE_S31_AEC_ENGINE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# ESP-SR's P4-class SIMD memcpy cannot load from RTC/LP memory (D5 fault at 0x2e003320).
# CONFIG_ESP_SYSTEM_ALLOW_RTC_FAST_MEM_AS_HEAP is not set
