root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false   # trailing double-space is a markdown line break
max_line_length = 100

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.{c,h,cpp,hpp,pio}]
indent_size = 4
max_line_length = 100

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2

[*.{conf,rules,service,target,timer}]
indent_size = 2

[*.{dts,dtsi}]
indent_size = 4
