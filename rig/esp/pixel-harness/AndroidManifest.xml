<?xml version="1.0" encoding="utf-8"?>
<!--
  LarkBridge Pixel harness: self-managed "calls that dial no one" for HIL rows H9 and H11.
  No telephony permission is requested (no CALL_PHONE, no READ_PHONE_STATE): the only way this
  app places a call is TelecomManager.placeCall() on its own CAPABILITY_SELF_MANAGED account,
  which Telecom routes to HarnessConnectionService and never to the SIM.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.larkbridge.harness"
    android:versionCode="2"
    android:versionName="0.2.0">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="34" />

    <!-- normal (granted at install) -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- runtime (grant with `adb shell pm grant`, see README) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="LarkBridge Harness"
        android:icon="@android:drawable/sym_call_outgoing"
        android:allowBackup="false">

        <!-- Launcher screen: shows status and asks for the runtime permissions. Not needed for rig use. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Control surfaces. Both are exported but require android.permission.DUMP, which the adb
          shell user holds and no third-party app can obtain, so only adb (or the system) can
          drive the harness.
        -->
        <receiver
            android:name=".ControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.larkbridge.harness.CALL_START" />
                <action android:name="dev.larkbridge.harness.CALL_END" />
                <action android:name="dev.larkbridge.harness.PLAY_STIMULUS" />
                <action android:name="dev.larkbridge.harness.STOP_STIMULUS" />
                <action android:name="dev.larkbridge.harness.SET_ROUTE" />
                <action android:name="dev.larkbridge.harness.STATUS" />
            </intent-filter>
        </receiver>

        <!-- Same actions via `am start`; brings the app to the foreground for the command. -->
        <activity
            android:name=".ControlActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.NoDisplay"
            android:excludeFromRecents="true"
            android:noHistory="true" />

        <service
            android:name=".HarnessConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <service
            android:name=".CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall|microphone" />
    </application>
</manifest>
