# rig/inventory.toml — the physical lab, as it actually is.
#
# Copy to rig/inventory.toml and fill in. That file is gitignored: it holds MAC
# addresses and host specifics for one bench.
#
# Rule for this file: identifiers must be STABLE. Hostnames, MACs and USB port paths
# survive reboots and replugs; `hw:1`, `card 2` and `hci0` indices do not.

# ---------------------------------------------------------------- control plane

pi_host       = "larkbridge"          # matches the Host entry in ~/.ssh/config
pi_ip         = "192.168.0.251"       # informational; ssh_config carries the real one
pi_user       = "admin"
pi_repo_path  = "~/rpi-lark-bridge"

# Closed-loop boot controller. Keep commands as argument arrays: they are executed directly,
# never through a shell. Leave empty until the corresponding bench hardware is installed.
boot_probe_host = "192.168.0.251"
boot_ssh_timeout_seconds = 8
boot_shutdown_timeout_seconds = 30
boot_timeout_seconds = 120
boot_cold_off_seconds = 10
boot_expected_microphone = "lark-a1" # use "fifine-k054" for a FIFINE campaign
boot_power_off_command = []
boot_power_on_command = []
boot_serial_capture_command = []
boot_functional_probe_command = []
# Applies a committed boot variant and arms its rollback timer before screening.
boot_variant_apply_command = ["python", "rig/boot/apply_variant.py", "--candidate", "{candidate}", "--revision", "{revision}", "--run-dir", "{run_dir}"]

# Pixel 7a. Leave phone_serial empty if only one device is ever attached.
# `adb devices` shows a USB serial; wireless shows <ip>:<port>, which changes on reboot,
# so prefer the USB serial here and let connect.sh rediscover the wireless endpoint.
phone_serial  = ""
phone_wifi_ssid = "abridge-village_5G"   # 5 GHz on purpose - see the plan's RF rationale

# ---------------------------------------------------------------- audio hardware
#
# Cheap dongles frequently share a serial number, so they are identified by USB PORT
# PATH. Once set, do not move them between ports. `rig unit U11` prints the paths.

lark_usb_id       = "3547:0407" # stable VID:PID; Lark may use any Pi USB port
lark_usb_serial   = ""          # optional if a future receiver exposes a unique serial
lark_port_path    = ""

# K054 descriptors are generic and contain no serial on the characterized unit. Leave the port
# blank for portable matching or set it to disambiguate another device with the same fingerprint.
fifine_usb_id       = "0c76:161e"
fifine_usb_serial   = ""
fifine_port_path    = ""

dongle_a_port_path = ""      # DUT output  - Mode 1W wired call audio
dongle_b_port_path = ""      # INSTRUMENT  - out drives the speaker, in captures the BT receiver

# E19 transparent-audio instrument. It is resolved afresh through USB sysfs on every
# run; the current ALSA card number is evidence, never identity. Moving the instrument,
# cable, or speaker invalidates its three-stage calibration.
generalplus_usb_id                 = "1b3f:2008"
generalplus_port_path              = "1-1.5"
generalplus_rate                   = 48000
generalplus_capture_channels       = 1
generalplus_playback_channels      = 2
generalplus_agc_control            = "Auto Gain Control"
generalplus_sidetone_control       = "Mic Playback Switch"
generalplus_capture_switch_control = "Mic Capture Switch"
generalplus_capture_volume_control = "Mic Capture Volume"
generalplus_cable_id               = "" # label the physical AUX/loopback cable
generalplus_speaker_position_id    = "" # label/tape the fixed speaker position

# Optional, explicit host-side capture hook for a consenting Discord far-end milestone.
# Tokens are executed directly (never through a shell); {seconds} and {out} are replaced.
# Example only -- choose the ffmpeg input supported by this Windows bench.
discord_far_end_capture_command = []

# ---------------------------------------------------------------- bluetooth

bt_receiver_mac = ""         # A2DP sink: both the "headphones" under test AND the capture tap
pixel_bt_mac    = ""         # the phone, as an HFP Audio Gateway

# ---------------------------------------------------------------- pico

pico_swd_swdio_gpio = 24     # matches openocd's shipped interface/raspberrypi-swd.cfg
pico_swd_swclk_gpio = 25
pico_run_gpio       = 26     # hard reset
pico_vbus_sense_gpio = 23    # tells "unplugged from phone" apart from "firmware crashed"

# ---------------------------------------------------------------- measurement

# Written by `rig calibrate` (U13/U15). Any DUT result below these is reported as
# "below rig resolution", never as a measurement.
cal_noise_floor_dbfs   = ""
cal_loopback_latency_ms = ""
cal_acoustic_snr_db     = ""

# Transparent-audio gates. Keep these explicit so evidence is reproducible.
e19_aux_volume                 = 0.95
e19_max_noise_floor_dbfs       = -60.0
e19_max_linearity_error_db     = 1.5
e19_min_dynamic_range_db       = 50.0
e19_min_aux_above_floor_db     = 40.0
e19_min_acoustic_snr_db        = 20.0
e19_max_clipping_pct           = 0.01
e19_min_call_raw_dbfs          = -55.0
e19_min_aec_suppression_db     = 10.0
