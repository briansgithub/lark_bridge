# This repo is edited on Windows and executed on Linux (Raspberry Pi OS).
# CRLF in a shell script or a systemd unit produces failures that look like anything
# but a line-ending problem ("bad interpreter: /bin/bash^M"). Force LF everywhere that
# the Pi will execute or parse.

* text=auto eol=lf

*.sh            text eol=lf
*.py            text eol=lf
*.conf          text eol=lf
*.rules         text eol=lf
*.service       text eol=lf
*.target        text eol=lf
*.timer         text eol=lf
*.dts           text eol=lf
*.dtsi          text eol=lf
*.lua           text eol=lf
*.toml          text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.md            text eol=lf
*.[ch]          text eol=lf
*.cpp           text eol=lf
*.pio           text eol=lf
*.ini           text eol=lf
Makefile        text eol=lf
CMakeLists.txt  text eol=lf

# Binary evidence from experiments — never touch these.
*.btsnoop       binary
*.pcap          binary
*.wav           binary
*.uf2           binary
*.png           binary
*.svg           text eol=lf

# Generated but committed (see ADR-0008); keep diffs readable, mark in review.
pico/i2s/*.pio.h linguist-generated=true
